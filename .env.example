# ========================================
# Identity Database (identity-db)
# ========================================
POSTGRES_USER=identity_user
POSTGRES_PASSWORD=<CHANGE-ME>
POSTGRES_DB=identity_db

# ========================================
# API Database (api-db)
# ========================================
API_POSTGRES_USER=padtime_user
API_POSTGRES_PASSWORD=<CHANGE-ME>
API_POSTGRES_DB=padtime

# ========================================
# Identity Server → identity-db connection
# ========================================
DB_HOST=identity-db
DB_PORT=5432
DB_NAME=identity_db
DB_USER=identity_user
DB_PASSWORD=<CHANGE-ME>

# ========================================
# Backend API → api-db connection
# ========================================
API_DB_HOST=api-db
API_DB_PORT=5432
API_DB_NAME=padtime
API_DB_USER=padtime_user
API_DB_PASSWORD=<CHANGE-ME>

# ========================================
# Gemini AI (Smart Slot Suggestions)
# ========================================
GEMINI_API_KEY=<YOUR-GEMINI-API-KEY>
